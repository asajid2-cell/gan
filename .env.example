# Example environment variables for portable paths.

# Root directory containing datasets (optional).
# If unset, code falls back to Z:/DataSets if it exists, else ./data
DGGR_DATA_ROOT=Z:/DataSets

# Directory containing cleaned manifests (optional).
# If unset, code falls back to <DGGR_DATA_ROOT>/_lab1_manifests, else ./data/_lab1_manifests
DGGR_MANIFESTS_ROOT=Z:/DataSets/_lab1_manifests

